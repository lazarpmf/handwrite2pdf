# Local Pix2Text service (npm run ocr)
OCR_SERVICE_URL=http://127.0.0.1:8765

# Secret used to mint/verify Pro license keys (change this before selling!)
PRO_LICENSE_SEED=change-me-to-a-long-random-string

# Buy Me a Coffee page shown on /pricing
# NEXT_PUBLIC_BMC_URL=https://buymeacoffee.com/tvojeime

# Webhook signing secret from Buy Me a Coffee → Integrations → webhook
# BMC_WEBHOOK_SECRET=
# One coffee must be at least this many dollars to unlock a week
BMC_MIN_AMOUNT=3
LICENSE_DAYS=7

# Email the generated code. Use Resend or SMTP. MAIL_FROM is required for either.
# RESEND_API_KEY=
# MAIL_FROM="InkTeX <kod@tvojadomena.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0
