# Google AI Studio key, server only. Never prefix with NEXT_PUBLIC_.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Secret used to mint/verify Pro license keys (change this before selling!)
PRO_LICENSE_SEED=change-me-to-a-long-random-string

# Buy Me a Coffee page shown on /pricing
# NEXT_PUBLIC_BMC_URL=https://buymeacoffee.com/tvojeime

# Webhook signing secret from Buy Me a Coffee → Integrations → webhook
# BMC_WEBHOOK_SECRET=
# 3$ unlocks a week. 8$ (or a membership) unlocks a month.
BMC_MIN_AMOUNT=3
BMC_MONTH_AMOUNT=8
LICENSE_DAYS=7
LICENSE_MONTH_DAYS=30

# Permanent free codes you invent, comma-separated. Or use: npm run gift -- DRAGANA-TAJNA
# GIFT_CODES=DRAGANA-TAJNA

# Email the generated code. Use Resend or SMTP. MAIL_FROM is required for either.
# RESEND_API_KEY=
# MAIL_FROM="InkTeX <kod@tvojadomena.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0
